{
  "name": "WoL Forwarder Dev",
  "version": "1.1.2",
  "slug": "wol_forward_app_dev",
  "description": "Wake-on-LAN (WoL) packets with  secureOn forwarding on your LAN.",
  "arch": ["aarch64", "amd64"],
  "url": "https://github.com/erkr/wol-forwarder#readme",
  "startup": "services",
  "boot": "auto",
  "host_network": false,
  "homeassistant": false,
  "homeassistant_api": true,
  "options": {
    "wol_port": 9,
    "secure_on": "a1:b2:c3:d4:e5:f6",
    "broadcast_ip": "192.168.1.255",
    "known_hosts": [],
    "host_filtering": false,
    "mac_list": [],
    "mac_filtering": false,
    "http_api_enabled": false,
    "webhook_id": ""
  },
  "schema": {
    "wol_port": "int(1,65535)",
    "secure_on": "match(^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$)",
    "broadcast_ip": "match(^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$)",
    "known_hosts": [{"host":"str", "name":"str"}],
    "host_filtering": "bool",
    "mac_list": [{"mac": "match(^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$)", "name":"str"}],
    "mac_filtering": "bool",
    "dns_ttl": "int(60,3600)?",
    "http_api_enabled": "bool",
    "webhook_id": "str",
    "webhook_sel": "list(all|forward|reject|disabled)?",
    "ha_api_url": "url?",
    "log_level": "list(debug|info|warning|error)?"
  },
  "ports": {
     "58080/tcp": null,
     "58090/udp": 58090
  },
  "options_description": "listen_port: input port for WoL packets with secureOn. wol_port: broadcast output port. broadcast_ip: destination broadcast IP. secure_on: hex string for secureOn. known_hosts: list of DNS or source IPs. http_api_enabled: enable HTTP status API. Webhook_id for reporting forwards",
  "image": "ghcr.io/erkr/wol-forwarder",
  "author": "ErKr"
}
